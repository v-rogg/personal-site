# =============================================================================
# Backend Environment Variables (for Rust API)
# =============================================================================

# Database
DATABASE_URL=/data/app.db

# SMTP (configure for your provider - Resend, mailbox.org, or any SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxx

# Friendly Captcha - Backend (secret key for verification)
FRIENDLY_CAPTCHA_SECRET=your-secret-key
FRIENDLY_CAPTCHA_SITEKEY=your-site-key

# Email configuration
EMAIL_FROM=noreply@valentinrogg.de
EMAIL_TO=mail@valentinrogg.de

# App settings
BASE_URL=https://valentinrogg.de

# GeoIP (optional - download MaxMind GeoLite2-City.mmdb)
# GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# Logging
RUST_LOG=info,vr_www_api=debug

# Crowdsec (generated after first run)
# CROWDSEC_BOUNCER_API_KEY=generated-by-cscli

# =============================================================================
# Frontend Environment Variables (for Astro)
# =============================================================================

# Friendly Captcha - Frontend (site key for widget)
PUBLIC_FRIENDLY_CAPTCHA_SITEKEY=your-site-key

# API URLs
# PUBLIC_API_URL - For client-side browser requests (empty = same-origin in production)
PUBLIC_API_URL=http://localhost:8080
# API_URL - For server-side requests within Docker network
API_URL=http://api:8080

# =============================================================================
# Development Modes
# =============================================================================
#
# Option 1: Full Docker (no HMR, but self-contained)
#   docker compose -f docker-compose.local.yml up -d --build
#   Access: http://localhost:8080
#
# Option 2: HMR Development (fast frontend changes)
#   docker compose -f docker-compose.dev.yml up -d --build
#   cd frontend && deno task dev
#   Access: http://localhost:8080
#
# Both modes use Caddy to proxy /api/* to the backend and serve /files/*

# =============================================================================
# Build Variables (for Docker build)
# =============================================================================

# Font Awesome Pro token (from https://fontawesome.com/account)
# Used by Docker builds. For local dev, create frontend/.npmrc with your token:
#   @awesome.me:registry=https://npm.fontawesome.com/
#   @fortawesome:registry=https://npm.fontawesome.com/
#   //npm.fontawesome.com/:_authToken=YOUR_TOKEN_HERE
# (Deno does not interpolate env vars in .npmrc — use the literal token)
FONTAWESOME_TOKEN=your-fontawesome-token
