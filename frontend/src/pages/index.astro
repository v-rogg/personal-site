---
import BaseLayout from "../layouts/BaseLayout.astro";
import Signatures from "../components/Signatures.svelte";
import ShortBio from "../components/ShortBio.svelte";
import SendRequest from "../components/SendRequest.svelte";
import GeoViewer from "../components/GeoViewer.svelte";
import Blog from "../components/Blog/Blog.svelte";
import { getSignaturesWithFirstData } from "../lib/api.server";
import { getCollection } from "astro:content";

// Server-side data fetching
const requestedSignature = Astro.url.searchParams.get("s");
const { signatures, preloadedSignatures, autoplay } = await getSignaturesWithFirstData(
	requestedSignature,
	5 // Preload first 5 signatures for smooth initial experience
);

// Get blog posts from content collection - only published
const allPosts = await getCollection("blog");
const blogPosts = allPosts
	.filter((post) => post.data.published)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Extract all unique tags
const allTags = [...new Set(blogPosts.flatMap((post) => post.data.tags || []))];

const title = "Valentin Rogg";
const description = "Geospatial Data Engineer. Dateninfrastruktur, Tooling und interaktive Visualisierung.";
---

<BaseLayout title={title} description={description}>
	<main class="container relative mx-auto flex flex-col gap-4">
		<Signatures
			client:load
			signatures={signatures}
			preloadedSignatures={preloadedSignatures}
			autoplay={autoplay}
		/>
		<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 xl:grid-cols-9">
			<ShortBio cls="xl:col-span-5" />
			<SendRequest client:visible cls="xl:col-span-4" />
		</div>

		<GeoViewer client:visible />

		{blogPosts.length > 0 && (
			<Blog client:visible blog={blogPosts} tags={allTags} />
		)}
	</main>
</BaseLayout>
